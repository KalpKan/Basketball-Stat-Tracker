# Names only, never values. Real values live in Vercel: project
# "v0-basketball-analytics-dashboard" -> Settings -> Environment Variables,
# and (for the Edge Functions) Supabase Project B "platform" -> Edge Functions -> Secrets.
# Never commit a real .env file; .gitignore already blocks them.

# Supabase Project B ("platform"). The dashboard reads the "hoops" schema with the
# service role key, server-side only (never NEXT_PUBLIC_).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared key the phone app sends as x-device-api-key to the hoops-ingest-shot
# Edge Function. Also set as an Edge Function secret in Supabase.
INGEST_API_KEY=

# PostHog analytics (portfolio docs/analytics.md). Public phc_ project token; the
# host is always /ingest because the app proxies analytics through its own origin.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=/ingest

# Optional Edge Function secret: lets hoops-ingest-shot send the shot_ingested event.
# POSTHOG_KEY=
